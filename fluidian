#!/usr/bin/env python3
"""Fluidian command line launcher. Run `./fluidian --help`."""
import os
import sys

if sys.version_info < (3, 8):
    sys.exit("Fluidian needs Python 3.8 or newer (found %s)." % sys.version.split()[0])
ROOT = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(ROOT, "engine"))

from fluidian.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
